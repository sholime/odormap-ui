# Copy to .env.local for local development. On Vercel, set these in the project settings.

# Where the OdorMap API runs. Locally: `npm run dev` in odormap-api.
VITE_API_URL=http://localhost:3000

# The Google OAuth client id (see odormap-api/docs/deploy-setup.md).
# Leave empty to hide the "Sign in with Google" button.
VITE_GOOGLE_CLIENT_ID=
